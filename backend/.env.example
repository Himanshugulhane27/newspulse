# ── NewsPulse Backend Environment Variables ─────────────────────────────
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to version control.

NODE_ENV=development
PORT=5001

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/newspulse

# JWT secret — use a long random string in production
JWT_SECRET=change-this-to-a-random-secret-in-production

# NewsAPI.org API key (free tier: https://newsapi.org/register)
NEWS_API_KEY=your-newsapi-key-from-newsapi.org

# Frontend URL for CORS and OAuth redirects
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 credentials (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback